# Hecho con asistencia de IA (Claude) — Seal Hackathon Team
# Copia este archivo como ".env.local" (no se sube a git) y pega los datos de tu app web de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → app web → firebaseConfig).
# Es opcional: también se puede pegar la configuración en la página /estacion.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
